/* pages/lobby/index.wxss — 进房入口页面 */

.lobby {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: var(--bg);
}

.lobby-card {
  width: 84%;
  max-width: 640rpx;
  padding: 56rpx 44rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.06);
}

.lobby-title {
  font-size: 44rpx;
  text-align: center;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.lobby-desc {
  text-align: center;
  font-size: 26rpx;
  color: var(--aux);
  margin-bottom: 40rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  background: var(--accent);
  color: #04110c;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 0;
}

.line {
  flex: 1;
  height: 1rpx;
  background: var(--border);
}

.dim { color: var(--aux); }

.join-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.code-input {
  flex: 1;
  height: 80rpx;
  text-align: center;
  font-size: 36rpx;
  letter-spacing: 16rpx;
  font-family: "SF Mono", "Consolas", monospace;
  color: var(--accent);
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}

.join-btn {
  flex: 0 0 auto;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx;
  margin: 0;
  background: var(--accent);
  color: #04110c;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.join-btn[disabled] { opacity: 0.4; }

.primary-btn { margin-bottom: 20rpx; }

.version {
  display: block;
  text-align: center;
  font-size: 20rpx;
  margin-top: 32rpx;
}
